# ============================================================
# SafeSliceSQL — Environment Configuration
# ============================================================
# Copy this file to .env and fill in your local credentials.
# NEVER commit the .env file to version control.
# ============================================================

# --- MySQL Source Database (read-only recommended) ---
SAFESLICE_SOURCE_HOST=localhost
SAFESLICE_SOURCE_PORT=3306
SAFESLICE_SOURCE_USER=root
SAFESLICE_SOURCE_PASSWORD=
SAFESLICE_SOURCE_DATABASE=employees

# --- MySQL Target Database (create/write permissions required) ---
SAFESLICE_TARGET_HOST=localhost
SAFESLICE_TARGET_PORT=3306
SAFESLICE_TARGET_USER=root
SAFESLICE_TARGET_PASSWORD=
SAFESLICE_TARGET_DATABASE=employees_slice

# --- Logging ---
SAFESLICE_LOG_LEVEL=INFO
SAFESLICE_LOG_DIR=logs

# --- Optional password references (choose FILE or KEYRING_SERVICE per role) ---
# SAFESLICE_SOURCE_PASSWORD_FILE=C:/private/source-password.txt
# SAFESLICE_TARGET_PASSWORD_FILE=C:/private/target-password.txt
# SAFESLICE_SOURCE_PASSWORD_KEYRING_SERVICE=SafeSliceSQL/source
# SAFESLICE_TARGET_PASSWORD_KEYRING_SERVICE=SafeSliceSQL/target
# See docs/production_controls.md for OS vault setup and MySQL account grants.

# --- Job resource limits; positive integers, sizes in bytes ---
SAFESLICE_LIMIT_JOB_SECONDS=600
SAFESLICE_LIMIT_STATEMENT_SECONDS=30
SAFESLICE_LIMIT_CONNECT_SECONDS=10
SAFESLICE_LIMIT_MAX_SOURCE_ROWS=5000000
SAFESLICE_LIMIT_MAX_RESULT_ROWS=1000000
SAFESLICE_LIMIT_MAX_INPUT_BYTES=104857600
SAFESLICE_LIMIT_MAX_CELL_BYTES=1048576
SAFESLICE_LIMIT_MAX_TEMP_BYTES=536870912
SAFESLICE_LIMIT_MAX_MEMORY_BYTES=1073741824
SAFESLICE_LIMIT_MAX_TABLES=100
SAFESLICE_LIMIT_MAX_COLUMNS=500
